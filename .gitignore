# Dependencies
node_modules/
*/node_modules/

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
*.env
server/.env
client/.env

# Build outputs
dist/
build/
client/dist/
server/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User uploads (keep folder, ignore uploaded images)
server/uploads/*
!server/uploads/.gitkeep

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Temporary directories
tmp/
temp/
